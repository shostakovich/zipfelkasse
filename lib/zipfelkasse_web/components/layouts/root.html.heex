<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <.theme_meta />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default={group_name()}>{assigns[:page_title]}</.live_title>
    <.theme_script nonce={assigns[:csp_nonce]} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/setzkasten/fonts/Figtree-Variable.woff2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      media="(prefers-color-scheme: light)"
      href={~p"/images/icons/favicon-light.png"}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      media="(prefers-color-scheme: dark)"
      href={~p"/images/icons/favicon-dark.png"}
    />
    <link rel="apple-touch-icon" href={~p"/images/icons/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <meta name="apple-mobile-web-app-title" content={group_name()} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-base-100 text-base-content">
    {@inner_content}
  </body>
</html>
