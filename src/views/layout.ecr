<!doctype html>
<%- look_name = look.to_s.downcase -%>
<html lang="de" data-look="<%= look_name %>"<% unless theme.auto? %> data-bs-theme="<%= theme.to_s.downcase %>"<% end %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= page.title %> · <%= group_name %></title>
  <%- if theme.auto? %>
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="<%= theme_color(false) %>" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="<%= theme_color(true) %>" media="(prefers-color-scheme: dark)">
  <%- else %>
  <meta name="color-scheme" content="<%= theme.to_s.downcase %>">
  <meta name="theme-color" content="<%= theme_color(theme.dark?) %>">
  <%- end %>
  <link rel="manifest" href="/manifest.webmanifest">
  <%- favicon, favicon_dark = themed_srcs("icons/favicon-#{look_name}", "png") %>
  <link rel="icon" href="<%= favicon %>" type="image/png" sizes="32x32"<% if favicon_dark %> media="(prefers-color-scheme: light)"<% end %>>
  <%- if favicon_dark %>
  <link rel="icon" href="<%= favicon_dark %>" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)">
  <%- end %>
  <link rel="apple-touch-icon" href="<%= static "icons/apple-touch-icon-#{look_name}.png" %>">
  <meta name="apple-mobile-web-app-title" content="<%= group_name %>">
  <link rel="stylesheet" href="https://felt-css.rocu.de/felt.css">
  <link rel="stylesheet" href="<%= static "app.css" %>">
  <script src="<%= static "app.js" %>" defer></script>
</head>
<body<% if me %> class="has-tabbar"<% end %>>
  <%- tabs = [{"/", "receipt", "Ausgaben", Nav::Expenses}, {"/salden", "scale", "Salden", Nav::Balances},
              {"/aktivitaet", "activity", "Aktivität", Nav::Activity}, {"/einstellungen", "settings", "Einstellungen", Nav::Settings}] %>
  <header class="container app-container app-header">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 gap-sm-3 pt-3 pb-1">
      <a class="app-brand d-flex align-items-center gap-2 text-decoration-none" href="/"><%- mascot, mascot_dark = themed_srcs("brand/mascot-#{look_name}", "webp") %><picture><%- if mascot_dark %><source srcset="<%= mascot_dark %>" media="(prefers-color-scheme: dark)"><% end %><img src="<%= mascot %>" alt=""></picture>Zipfelkasse</a>
      <%- if user = me %>
      <p class="whoami small text-body-secondary mb-0">Du bist <strong class="text-body"><%= user.name %></strong> · <a href="/wer">wechseln</a></p>
      <%- end %>
    </div>
    <%- if me %>
    <nav class="d-none d-sm-block mt-3" aria-label="Hauptnavigation">
      <ul class="nav nav-pills">
        <%- tabs.each do |href, icon_name, label, nav| %>
        <li class="nav-item"><a class="nav-link d-flex align-items-center gap-2<% if page.nav == nav %> active<% end %>"<% if page.nav == nav %> aria-current="page"<% end %> href="<%= href %>"><%= plush icon_name %><span><%= label %></span></a></li>
        <%- end %>
      </ul>
    </nav>
    <%- end %>
  </header>
  <main class="container app-container app-main">
    <%- if flash %>
    <p class="alert alert-success" role="status"><%= flash %></p>
    <%- end %>
    <%- if page.error %>
    <p class="alert alert-danger" role="alert"><%= page.error %></p>
    <%- end %>
    <%= content %>
  </main>
  <%- if me %>
  <nav class="navbar fixed-bottom pb-safe app-tabbar d-sm-none" aria-label="Hauptnavigation">
    <ul class="nav nav-pills nav-fill w-100">
      <%- tabs.each do |href, icon_name, label, nav| %>
      <li class="nav-item"><a class="nav-link d-flex flex-column align-items-center<% if page.nav == nav %> active<% end %>"<% if page.nav == nav %> aria-current="page"<% end %> href="<%= href %>"><%= plush icon_name %><small><%= label %></small></a></li>
      <%- end %>
    </ul>
  </nav>
  <%- end %>
  <%- page.scripts.each do |script| %>
  <script src="<%= static script %>" defer></script>
  <%- end %>
</body>
</html>
