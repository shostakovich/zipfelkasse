<section class="card">
  <div class="card-header">
    <h1 class="card-title h5 mb-0">Wiederkehrende Ausgaben</h1>
    <p class="card-text small fw-normal text-body-secondary mt-1 mb-0">Eine wiederkehrende Ausgabe legst du bei einer bestehenden Ausgabe über
      „Als wiederkehrend einrichten“ an. Fällige Termine werden automatisch als Ausgaben eingetragen – auch verpasste.
      Gibt es an einem Termin schon eine Ausgabe mit gleichem Titel, Betrag und Zahler, wird er übersprungen.
      Pausierte Termine werden beim Fortsetzen nicht nachgeholt.</p>
  </div>
  <div class="card-body">
    <%- unless rules.empty? %>
    <div class="table-responsive">
      <table class="table table-sm small mb-0">
        <thead>
          <tr><th>Ausgabe</th><th class="d-none d-sm-table-cell">Betrag</th><th class="d-none d-sm-table-cell">Nächster Termin</th></tr>
        </thead>
        <tbody>
        <%- rules.each do |row| %>
          <%- rule = row.rule %>
          <%- amount = rule.template.original_currency == "EUR" ? eur(rule.template.amount_cents) : money(rule.template.original_amount_minor, rule.template.original_currency) %>
          <tr>
            <td>
              <div class="vstack gap-1">
                <strong><%= rule.template.title %></strong>
                <span class="text-body-secondary"><%= Web.frequency_label(rule.frequency) %> seit <%= date rule.start_date %><% if name = row.paid_by_name %> · zahlt <%= name %><% end %></span>
                <span class="d-sm-none"><span class="tabular-nums"><%= amount %></span> · <% if rule.active? %>nächster Termin <%= date rule.next_date %><% else %>pausiert<% end %></span>
              </div>
              <div class="d-flex flex-wrap align-items-start gap-1 mt-1">
                <%- if rule.active? %>
                <form method="post" action="/einstellungen/wiederkehrend/<%= rule.id %>/pausieren">
                  <button class="btn btn-sm btn-light" type="submit">Pausieren</button>
                </form>
                <%- else %>
                <form method="post" action="/einstellungen/wiederkehrend/<%= rule.id %>/fortsetzen">
                  <button class="btn btn-sm btn-light" type="submit">Fortsetzen</button>
                </form>
                <%- end %>
                <form method="post" action="/einstellungen/wiederkehrend/<%= rule.id %>/vorlage">
                  <button class="btn btn-sm" type="submit" title="Betrag, Aufteilung usw. der zuletzt eingetragenen Ausgabe dieser Wiederholung übernehmen">Vorlage aktualisieren</button>
                </form>
                <details>
                  <summary class="btn btn-sm">Löschen…</summary>
                  <form class="vstack gap-2 align-items-start mt-2" method="post" action="/einstellungen/wiederkehrend/<%= rule.id %>/loeschen">
                    <p class="form-text mt-0 mb-0">Bereits eingetragene Ausgaben bleiben erhalten.</p>
                    <button class="btn btn-sm btn-danger" type="submit">Wiederholung löschen</button>
                  </form>
                </details>
              </div>
            </td>
            <td class="d-none d-sm-table-cell tabular-nums text-nowrap"><%= amount %></td>
            <td class="d-none d-sm-table-cell text-nowrap"><% if rule.active? %><%= date rule.next_date %><% else %><span class="badge text-bg-light">pausiert</span><% end %></td>
          </tr>
        <%- end %>
        </tbody>
      </table>
    </div>
    <%- else %>
    <p class="text-body-secondary mb-0">Noch keine wiederkehrenden Ausgaben.</p>
    <%- end %>
  </div>
</section>
