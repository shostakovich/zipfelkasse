<section class="card">
  <div class="card-header">
    <h1 class="card-title h5 mb-0">Wiederkehrende Ausgabe anlegen</h1>
    <%- if expense %>
    <p class="card-text small fw-normal text-body-secondary mt-1 mb-0">Die Ausgabe dient als Vorlage und ist der erste Termin. Weitere Termine werden
      automatisch mit denselben Angaben eingetragen.</p>
    <%- end %>
  </div>
  <%- if e = expense %>
  <div class="card-body">
    <div class="table-responsive"><table class="table table-sm small mb-0"><tbody>
      <tr><th class="fw-normal text-body-secondary text-nowrap" scope="row">Titel</th><td><strong><%= e.title %></strong></td></tr>
      <tr><th class="fw-normal text-body-secondary text-nowrap" scope="row">Betrag</th><td class="tabular-nums">
        <%- if e.foreign? %><%= money e.original_amount_minor, e.original_currency %> (<%= eur e.amount_cents %>; künftig zum Kurs des jeweiligen Tages)
        <%- else %><%= eur e.amount_cents %><% end %></td></tr>
      <tr><th class="fw-normal text-body-secondary text-nowrap" scope="row">Bezahlt von</th><td><%= e.paid_by_name %></td></tr>
      <%- if e.category_name %>
      <tr><th class="fw-normal text-body-secondary text-nowrap" scope="row">Kategorie</th><td><%= e.category_name %></td></tr>
      <%- end %>
      <tr><th class="fw-normal text-body-secondary text-nowrap" scope="row">Aufteilung</th><td><%= Web.split_mode_label(e.split_mode) %></td></tr>
      <%- unless e.notes.empty? %>
      <tr><th class="fw-normal text-body-secondary text-nowrap" scope="row">Notiz</th><td><%= e.notes %></td></tr>
      <%- end %>
      <tr><th class="fw-normal text-body-secondary text-nowrap" scope="row">Erster Termin</th><td><%= date e.date %></td></tr>
    </tbody></table></div>
  </div>
  <%- end %>
  <div class="card-body<% if expense %> border-top<% end %>">
  <%- if e = expense %>
    <%- if existing %>
    <p>Diese Ausgabe gehört schon zu einer wiederkehrenden Ausgabe.</p>
    <p class="mb-0"><a href="/einstellungen/wiederkehrend">Zu den wiederkehrenden Ausgaben</a></p>
    <%- else %>
    <form method="post" action="/einstellungen/wiederkehrend/neu">
      <input type="hidden" name="ausgabe" value="<%= e.id %>">
      <fieldset class="vstack gap-2 mb-3">
        <legend class="form-label">Wie oft?</legend>
        <%- options.each do |o| %>
        <label class="form-check align-items-start">
          <input class="form-check-input mt-0" type="radio" name="haeufigkeit" value="<%= o.value.key %>" required<% if o.checked %> checked<% end %>>
          <span><%= o.label %> <span class="text-body-secondary">– nächster Termin <%= date o.next_date %><% unless (note = o.note).empty? %>; <%= note %><% end %></span></span>
        </label>
        <%- end %>
      </fieldset>
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-primary" type="submit">Als wiederkehrend einrichten</button>
        <a class="btn" href="/ausgaben/<%= e.id %>">Abbrechen</a>
      </div>
    </form>
    <%- end %>
  <%- else %>
    <p class="text-body-secondary">Öffne zuerst die Ausgabe, die sich wiederholen soll, und wähle dort „Als wiederkehrend einrichten“.</p>
    <p class="mb-0"><a href="/">Zu den Ausgaben</a></p>
  <%- end %>
  </div>
</section>
