<section class="card card-bleed">
  <div class="card-header">
    <h1 class="card-title">Aktivität</h1>
    <p class="card-description">Wer hat wann was angelegt, geändert oder gelöscht.</p>
  </div>
  <div class="card-content" data-more-list>
    <%- groups.each do |label, items| %>
    <div class="activity-group" data-group="<%= label %>">
      <h2 class="list-group-label"><%= label %></h2>
      <%- items.each do |item| %>
      <%= Views::ActivityEntry.new(item, true) %>
      <%- end %>
    </div>
    <%- end %>
    <%- if groups.empty? %>
    <p class="small">Noch keine Aktivität.</p>
    <%- end %>
    <%- if more %>
    <div class="list-more"><a class="btn btn-outline" href="<%= more %>" data-more>Ältere anzeigen</a></div>
    <%- end %>
  </div>
</section>
