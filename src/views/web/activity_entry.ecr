<%- if link %>
<a class="activity-item list-group-item list-group-item-action d-flex align-items-center gap-3" href="/ausgaben/<%= a.expense_id %>">
<%- else %>
<div class="activity-item list-group-item d-flex align-items-center gap-3">
<%- end %>
  <div class="activity-main flex-grow-1 text-break small">
    <div>
      <%- if a.verb -%>
      <strong><%= a.actor %></strong> hat <em>„<%= a.details.title %>“</em> <%= a.verb %><% if a.show_amount %> <span class="tabular-nums text-nowrap text-body-secondary">(<%= eur a.amount_cents %>)</span><% end %>.
      <%- else -%>
      <strong><%= a.actor %></strong>: <%= a.details.text || a.action.key %>
      <%- end -%>
    </div>
    <%- unless a.details.changes.empty? %>
    <ul class="changes list-unstyled small text-body-secondary mt-1 mb-0">
      <%- a.details.changes.each do |c| %>
      <li><%= c.field %>: <del><%= c.old.empty? ? "–" : c.old %></del> → <ins class="text-decoration-none text-body"><%= c.new.empty? ? "–" : c.new %></ins></li>
      <%- end %>
    </ul>
    <%- end %>
    <div class="activity-time small text-body-secondary tabular-nums mt-1"><time datetime="<%= a.at.to_rfc3339 %>"><%= date_time a.at %></time></div>
  </div>
<%- if link %>
  <span class="expense-chevron text-body-secondary d-none d-sm-block"><%= icon "chevron-right" %></span>
</a>
<%- else %>
</div>
<%- end %>
