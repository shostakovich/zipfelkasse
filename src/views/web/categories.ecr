<div class="vstack gap-3">
  <section class="card">
    <div class="card-header">
      <h1 class="card-title h5 mb-0">Kategorien</h1>
      <p class="card-text small fw-normal text-body-secondary mt-1 mb-0">Umbenennen, sortieren oder archivieren. Archivierte Kategorien stehen bei neuen Ausgaben nicht mehr zur Wahl.</p>
    </div>
    <ul class="list-group list-group-flush">
      <%- active.each do |row| %>
      <li class="list-group-item" id="kategorie-<%= row.id %>">
        <div class="row g-2 align-items-center">
          <%= RenameForm.new("/einstellungen/kategorien", row, category_icon(row.name)) %>
          <div class="row-actions col-auto order-last order-sm-0 d-flex gap-1">
            <form method="post" action="/einstellungen/kategorien/<%= row.id %>/hoch">
              <button class="btn btn-icon" type="submit" title="Nach oben" aria-label="<%= row.name %> nach oben"<% if row.first %> disabled<% end %>><%= icon "chevron-up" %></button>
            </form>
            <form method="post" action="/einstellungen/kategorien/<%= row.id %>/runter">
              <button class="btn btn-icon" type="submit" title="Nach unten" aria-label="<%= row.name %> nach unten"<% if row.last %> disabled<% end %>><%= icon "chevron-down" %></button>
            </form>
            <form method="post" action="/einstellungen/kategorien/<%= row.id %>/archivieren">
              <button class="btn btn-icon" type="submit" title="Archivieren" aria-label="<%= row.name %> archivieren"><%= icon "archive" %></button>
            </form>
          </div>
          <p class="row-meta col col-sm-12 order-sm-last small text-body-secondary mb-0"><%= expense_count row.expenses %></p>
        </div>
      </li>
      <%- end %>
    </ul>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title h5 mb-0">Kategorie hinzufügen</h2>
    </div>
    <div class="card-body">
      <form method="post" action="/einstellungen/kategorien" class="d-flex gap-2">
        <label class="visually-hidden" for="neu-name">Name</label>
        <input class="form-control" id="neu-name" name="name" value="<%= name %>" required maxlength="60" placeholder="Name" autocomplete="off">
        <button class="btn btn-primary" type="submit"><%= icon "plus" %> Hinzufügen</button>
      </form>
    </div>
  </section>

  <%= ArchivedRows.new("/einstellungen/kategorien", "kategorie", archived) %>
  <p class="small mb-0"><a href="/einstellungen">← Zurück zu den Einstellungen</a></p>
</div>
