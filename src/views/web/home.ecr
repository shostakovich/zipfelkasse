<div class="vstack gap-3">
  <section class="card">
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <p class="card-text small mb-1">Dein Saldo</p>
        <p class="my-balance-amount fs-3 fw-bold tabular-nums mb-1 <%= sign_class balance %>"><%= eur balance %></p>
        <p class="form-text mb-0"><% if balance > 0 %>Du bekommst noch Geld.<% elsif balance < 0 %>Du schuldest noch Geld.<% else %>Alles ausgeglichen.<% end %></p>
      </div>
      <a class="btn btn-light" href="/salden"><%= plush "scale" %> Salden</a>
    </div>
  </section>

  <section class="card card-bleed">
    <div class="card-header d-flex align-items-start justify-content-between gap-3">
      <div>
        <h1 class="card-title h5 mb-0">Ausgaben</h1>
        <p class="card-text small fw-normal text-body-secondary mt-1 mb-0">Alle Ausgaben und Rückzahlungen der Gruppe.</p>
      </div>
      <a class="btn btn-primary d-none d-sm-inline-flex" href="/ausgaben/neu"><%= icon "plus" %> Ausgabe hinzufügen</a>
    </div>
    <div data-more-list data-sync-url>
      <form class="search card-body vstack gap-2" method="get" action="/" role="search">
        <label class="visually-hidden" for="q">Suche</label>
        <div class="input-group">
          <span class="input-group-text text-body-secondary"><%= icon "search" %></span>
          <input class="form-control" id="q" type="search" name="q" value="<%= filter.text %>" placeholder="Nach einer Ausgabe suchen …" maxlength="200" enterkeyhint="search">
        </div>
        <div class="search-filters row g-2">
          <div class="col-6 col-sm">
            <label class="visually-hidden" for="kategorie">Kategorie</label>
            <select class="form-select" id="kategorie" name="kategorie" data-autosubmit>
              <option value="">Alle Kategorien</option>
              <%- categories.each do |c| %>
              <option value="<%= c.id %>"<% if c.id == filter.category_id %> selected<% end %>><%= c.name %></option>
              <%- end %>
            </select>
          </div>
          <div class="col-6 col-sm">
            <label class="visually-hidden" for="person">Person</label>
            <select class="form-select" id="person" name="person" data-autosubmit>
              <option value="">Alle Personen</option>
              <%- participants.each do |p| %>
              <option value="<%= p.id %>"<% if p.id == filter.participant_id %> selected<% end %>><%= p.name %></option>
              <%- end %>
            </select>
          </div>
          <div class="search-submit col-12 col-sm-auto">
            <button class="btn btn-secondary w-100" type="submit">Suchen</button>
          </div>
        </div>
        <%- if filter.active? %>
        <p class="form-text mb-0"><a href="/">Filter zurücksetzen</a></p>
        <%- end %>
      </form>

      <%- groups.each do |label, rows| %>
      <div class="expense-group list-group list-group-flush border-top rounded-0" data-group="<%= label %>">
        <h2 class="list-group-label small text-uppercase fw-bold text-body-secondary px-3 pt-3 pb-2 mb-0"><%= label %></h2>
        <%- rows.each do |row| %>
        <a class="expense list-group-item list-group-item-action d-flex align-items-center gap-3<% if row.reimbursement? %> reimbursement<% end %>" id="ausgabe-<%= row.id %>" href="/ausgaben/<%= row.id %>">
          <%- if row.reimbursement? %>
          <span class="expense-icon"><%= plush "banknote" %></span>
          <%- else %>
          <span class="expense-icon"><%= plush category_icon(row.category_name) %></span>
          <%- end %>
          <span class="expense-main flex-grow-1 text-break">
            <span class="expense-title d-block fw-semibold<% if row.reimbursement? %> fst-italic<% end %>"><%= row.title %><% if row.recurring_id %> <span class="badge bg-secondary-subtle text-secondary-emphasis" title="Wiederkehrend"><%= icon "repeat" %></span><% end %></span>
            <span class="expense-meta d-block small text-body-secondary">
              <%- if row.reimbursement? -%>
              <strong><%= row.paid_by_name %></strong> an <strong><%= row.for_names[0] %></strong>
              <%- else -%>
              Bezahlt von <strong><%= row.paid_by_name %></strong> für <% if row.everyone %><strong>alle</strong><% else %><% row.for_names.each_with_index do |n, i| %><% if i > 0 %>, <% end %><strong><%= n %></strong><% end %><% end %>
              <%- end -%>
            </span>
            <span class="expense-meta d-block small text-body-secondary">
              <%- if row.involved %>Dein Saldo: <span class="<%= sign_class row.my_balance %>"><strong><%= eur row.my_balance %></strong></span><% else %>Du bist nicht beteiligt<% end -%>
            </span>
          </span>
          <span class="expense-side text-end text-nowrap tabular-nums">
            <span class="expense-amount d-block<% if row.reimbursement? %> fst-italic<% else %> fw-bold<% end %>"><%= eur row.amount_cents %></span>
            <%- if row.foreign? %>
            <span class="d-block small text-body-secondary"><%= money row.original_amount_minor, row.original_currency %></span>
            <%- end %>
            <span class="d-block small text-body-secondary"><%= date row.date %></span>
          </span>
          <span class="expense-chevron d-none d-sm-block text-body-secondary"><%= icon "chevron-right" %></span>
        </a>
        <%- end %>
      </div>
      <%- end %>
      <%- if groups.empty? %>
      <%- if filter.active? %>
      <p class="empty card-body small mb-0 border-top">Keine Ausgaben gefunden. <a href="/">Filter zurücksetzen</a></p>
      <%- else %>
      <p class="empty card-body small mb-0 border-top">Noch keine Ausgaben. <a href="/ausgaben/neu">Erste Ausgabe anlegen</a></p>
      <%- end %>
      <%- end %>

      <%- if more %>
      <div class="list-more card-body border-top text-center"><a class="btn btn-light" href="<%= more %>" data-more>Weitere anzeigen</a></div>
      <%- end %>
    </div>
  </section>
</div>
<a class="fab btn btn-primary btn-lg btn-pill shadow-lg d-sm-none" href="/ausgaben/neu" aria-label="Ausgabe hinzufügen"><%= icon "plus" %> Ausgabe</a>
