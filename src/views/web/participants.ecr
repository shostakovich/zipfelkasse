<div class="vstack gap-3">
  <section class="card">
    <div class="card-header">
      <h1 class="card-title h5 mb-0">Teilnehmer</h1>
      <p class="card-text small fw-normal text-body-secondary mt-1 mb-0">Personen umbenennen oder archivieren. Archivierte Personen stehen bei neuen Ausgaben nicht mehr zur Wahl; ihre alten Ausgaben bleiben erhalten.</p>
    </div>
    <ul class="list-group list-group-flush">
      <%- active.each do |row| %>
      <li class="list-group-item" id="person-<%= row.id %>">
        <div class="row g-2 align-items-center">
          <%= RenameForm.new("/einstellungen/teilnehmer", row) %>
          <form class="col-auto order-last order-sm-0" method="post" action="/einstellungen/teilnehmer/<%= row.id %>/archivieren">
            <button class="btn btn-icon" type="submit" title="Archivieren" aria-label="<%= row.name %> archivieren"
              data-confirm="<%= row.name %> archivieren?"><%= icon "archive" %></button>
          </form>
          <p class="row-meta col col-sm-12 order-sm-last small text-body-secondary mb-0">
            <%= expense_count row.expenses %> · Saldo <span class="tabular-nums text-nowrap <%= sign_class row.balance %>"><%= eur row.balance %></span>
            <%- if me.id == row.id %> · <strong class="text-body">das bist du</strong><% end %>
          </p>
        </div>
      </li>
      <%- end %>
    </ul>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title h5 mb-0">Person hinzufügen</h2>
    </div>
    <div class="card-body">
      <form method="post" action="/einstellungen/teilnehmer" class="d-flex gap-2">
        <label class="visually-hidden" for="neu-name">Name</label>
        <input class="form-control" id="neu-name" name="name" value="<%= name %>" required maxlength="60" placeholder="Name" autocomplete="off">
        <button class="btn btn-primary" type="submit"><%= icon "plus" %> Hinzufügen</button>
      </form>
    </div>
  </section>

  <%= ArchivedRows.new("/einstellungen/teilnehmer", "person", archived) %>
  <p class="small mb-0"><a href="/einstellungen">← Zurück zu den Einstellungen</a></p>
</div>
