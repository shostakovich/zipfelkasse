<form class="col-12 col-sm" method="post" action="<%= action %>/<%= row.id %>">
            <label class="visually-hidden" for="name-<%= row.id %>">Name</label>
            <div class="input-group">
              <%- if name = icon_name %>
              <span class="input-group-text py-0 px-2"><%= plush name %></span>
              <%- end %>
              <input class="form-control" id="name-<%= row.id %>" name="name" value="<%= row.name %>" required maxlength="60">
              <button class="btn btn-light" type="submit" title="Umbenennen" aria-label="<%= row.name %> umbenennen"><%= icon "save" %></button>
            </div>
          </form>
