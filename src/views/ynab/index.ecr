<div class="stack">
  <section class="card">
    <div class="card-header">
      <h1 class="card-title">YNAB</h1>
      <p class="card-description">Deine Anteile an geteilten Ausgaben automatisch in dein eigenes YNAB übertragen.</p>
    </div>
    <div class="card-content stack-sm">
      <p><strong>So funktioniert’s:</strong></p>
      <ol class="stack-sm">
        <li>Lege in YNAB ein Konto <strong>„Geteilt“</strong> an (im Budget, z. B. Typ „Cash“). Als Startsaldo trägst du deinen Saldo in Zipfelkasse am Tag vor dem Startdatum ein.</li>
        <li>Zipfelkasse schreibt dort für jede geteilte Ausgabe <strong>nur deinen Anteil</strong> als Ausgabe – mit der YNAB-Kategorie aus der Zuordnung unten.</li>
        <li>Bezahlst du eine geteilte Ausgabe mit deiner Karte, markierst du die Buchung im Bankkonto als <strong>Transfer → „Geteilt“</strong> statt sie zu kategorisieren.</li>
        <li>Rückzahlungen (du überweist jemandem Geld oder bekommst welches) markierst du ebenso als Transfer zwischen Bankkonto und „Geteilt“. Zipfelkasse schreibt Rückzahlungen nicht selbst.</li>
      </ol>
      <p class="muted">Dann entspricht der Saldo von „Geteilt“ in YNAB deinem Saldo in Zipfelkasse (positiv: du bekommst Geld).</p>
    </div>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Verbindung</h2>
      <p class="card-description">Persönlicher Zugriffstoken aus YNAB: Account Settings → Developer Settings → New Token. Er wird nur auf diesem Server gespeichert und nie wieder angezeigt.</p>
    </div>
    <div class="card-content stack">
      <%- if data.token_set %>
      <%- if data.token_invalid %>
      <p class="alert alert-destructive" role="alert">Der gespeicherte Token ist ungültig oder abgelaufen. Bitte einen neuen eintragen.</p>
      <%- else %>
      <p>Token: <strong>gesetzt</strong></p>
      <%- end %>
      <%- end %>
      <form method="post" action="/einstellungen/ynab/token" class="form">
        <div class="field">
          <label for="token"><% if data.token_set %>Token ersetzen<% else %>Token<% end %></label>
          <input id="token" name="token" type="password" autocomplete="off" spellcheck="false" maxlength="200" required>
        </div>
        <div class="row">
          <button class="btn btn-primary" type="submit"><% if data.token_set %>Token ersetzen<% else %>Verbinden<% end %></button>
        </div>
      </form>
      <%- if data.token_set %>
      <form method="post" action="/einstellungen/ynab/trennen">
        <button class="btn btn-outline btn-sm" type="submit">Verbindung trennen</button>
      </form>
      <%- end %>
    </div>
  </section>

  <%- if data.token_set && !data.token_invalid %>
  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Plan und Konto</h2>
      <p class="card-description">Das Verrechnungskonto „Geteilt“ und ab wann deine Anteile übertragen werden.</p>
    </div>
    <div class="card-content stack">
      <%- if data.api_error %>
      <p class="alert alert-destructive" role="alert"><%= data.api_error %></p>
      <%- end %>
      <%- if data.currency %>
      <p class="alert alert-destructive" role="alert">Achtung: Dieser Plan rechnet in <%= data.currency %>. Zipfelkasse überträgt Euro-Beträge.</p>
      <%- end %>
      <%- if !data.plans.empty? %>
      <form method="post" action="/einstellungen/ynab/konto" class="form">
        <div class="field">
          <label for="ziel">Konto</label>
          <select id="ziel" name="ziel" required>
            <option value="">Bitte wählen …</option>
            <%- data.plans.each do |plan| %>
            <optgroup label="<%= plan.name %>">
              <%- plan.accounts.each do |account| %>
              <option value="<%= account.value %>"<% if account.selected %> selected<% end %>><%= account.name %></option>
              <%- end %>
            </optgroup>
            <%- end %>
          </select>
          <p class="help">Nur offene Konten im Budget. Bei einem Wechsel bleiben die bisherigen Buchungen im alten Konto; im neuen wird angelegt, was dort noch fehlt.</p>
        </div>
        <div class="field">
          <label for="start">Startdatum</label>
          <input id="start" name="start" type="date" value="<%= data.start_date %>" required>
          <p class="help">Übertragen werden Ausgaben ab diesem Datum (bis heute). Ältere Ausgaben, die du erst nach dem Einrichten nachträglich erfasst, werden auch übertragen – der Startsaldo kennt sie ja nicht. Schon übertragene Ausgaben bleiben in YNAB, auch wenn ihr Datum oder das Startdatum später verschoben wird.</p>
        </div>
        <div class="row">
          <button class="btn btn-primary" type="submit">Speichern</button>
          <a class="btn btn-ghost btn-sm" href="/einstellungen/ynab?neu=1">Listen von YNAB neu laden</a>
        </div>
      </form>
      <%- elsif data.api_error.nil? %>
      <p class="muted">In deinem YNAB gibt es kein offenes Konto im Budget. Lege zuerst das Konto „Geteilt“ an und lade die <a href="/einstellungen/ynab?neu=1">Liste neu</a>.</p>
      <%- end %>
    </div>
  </section>
  <%- end %>

  <%- if data.has_target && !data.categories.empty? %>
  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Kategorien</h2>
      <p class="card-description">Welche YNAB-Kategorie bekommt dein Anteil? Ohne Zuordnung landet er unkategorisiert in YNAB.</p>
    </div>
    <div class="card-content">
      <%- if !data.groups.empty? %>
      <form method="post" action="/einstellungen/ynab/kategorien" class="form">
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th scope="col">In Zipfelkasse</th><th scope="col">In YNAB</th></tr>
            </thead>
            <tbody>
              <%- data.categories.each do |row| %>
              <%- sel = row.selected %>
              <tr>
                <td><label for="kat-<%= row.id %>"><%= row.name %></label><% if row.archived %> <span class="muted">(archiviert)</span><% end %></td>
                <td>
                  <select id="kat-<%= row.id %>" name="kat-<%= row.id %>">
                    <option value="">– unkategorisiert –</option>
                    <%- if row.missing %>
                    <option value="<%= sel %>" selected>Nicht mehr vorhanden (in YNAB gelöscht oder versteckt)</option>
                    <%- end %>
                    <%- data.groups.each do |group| %>
                    <optgroup label="<%= group.name %>">
                      <%- group.categories.each do |cat| %>
                      <option value="<%= cat.id %>"<% if cat.id == sel %> selected<% end %>><%= cat.name %></option>
                      <%- end %>
                    </optgroup>
                    <%- end %>
                  </select>
                </td>
              </tr>
              <%- end %>
            </tbody>
          </table>
        </div>
        <div class="row">
          <button class="btn btn-primary" type="submit">Zuordnung speichern</button>
        </div>
      </form>
      <%- else %>
      <p class="muted">Die Kategorien aus YNAB konnten nicht geladen werden.</p>
      <%- end %>
    </div>
  </section>
  <%- end %>

  <%- if data.token_set %>
  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Status</h2>
    </div>
    <div class="card-content stack-sm">
      <p>Dein Saldo in Zipfelkasse: <strong class="amount <%= sign_class(data.balance) %>"><%= eur(data.balance) %></strong> <span class="muted">– so viel sollte auch „Geteilt“ in YNAB zeigen.</span></p>
      <%- if data.ready %>
      <p>Synchronisierte Buchungen: <strong><%= data.synced %></strong></p>
      <%- if last_sync = data.status.last_sync %>
      <p>Letzter Abgleich: <%= date_time(last_sync) %><% unless data.status.summary.empty? %> <span class="muted">(<%= data.status.summary %>)</span><% end %></p>
      <%- else %>
      <p class="muted">Noch nicht synchronisiert.</p>
      <%- end %>
      <%- unless data.status.error.empty? %>
      <p class="alert alert-destructive" role="alert"><%= data.status.error %></p>
      <%- end %>
      <%- if retry_at = data.retry_at %>
      <p class="muted">Nächster Versuch ab <%= date_time(retry_at) %>.</p>
      <%- end %>
      <%- else %>
      <p class="muted">Sobald Plan, Konto und Startdatum gewählt sind, synchronisiert Zipfelkasse automatisch: kurz nach jeder Änderung und stündlich.</p>
      <%- end %>
    </div>
    <%- unless data.problems.empty? %>
    <div class="card-content">
      <h3>Fehler bei einzelnen Ausgaben</h3>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col">Datum</th><th scope="col">Ausgabe</th><th scope="col">Fehler</th></tr>
          </thead>
          <tbody>
            <%- data.problems.each do |problem| %>
            <tr>
              <td><%= date(problem.date) %></td>
              <td><a href="/ausgaben/<%= problem.expense_id %>"><%= problem.title %></a></td>
              <td><%= problem.error %></td>
            </tr>
            <%- end %>
          </tbody>
        </table>
      </div>
    </div>
    <%- end %>
    <%- if data.ready %>
    <div class="card-footer">
      <form method="post" action="/einstellungen/ynab/sync">
        <button class="btn btn-secondary" type="submit">Jetzt synchronisieren</button>
      </form>
    </div>
    <%- end %>
  </section>
  <%- end %>
</div>
