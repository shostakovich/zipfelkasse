OFXHEADER:100
DATA:OFXSGML
VERSION:102
SECURITY:NONE
ENCODING:UTF-8
CHARSET:NONE
COMPRESSION:NONE
OLDFILEUID:NONE
NEWFILEUID:NONE

<OFX>
<SIGNONMSGSRSV1>
<SONRS>
<STATUS>
<CODE>0
<SEVERITY>INFO
</STATUS>
<DTSERVER><%= now.to_utc.to_s("%Y%m%d%H%M%S") %>
<LANGUAGE>GER
</SONRS>
</SIGNONMSGSRSV1>
<BANKMSGSRSV1>
<STMTTRNRS>
<TRNUID>1
<STATUS>
<CODE>0
<SEVERITY>INFO
</STATUS>
<STMTRS>
<CURDEF>EUR
<BANKACCTFROM>
<BANKID>ZIPFEL
<ACCTID><%= sgml(account_id, 22) %>
<ACCTTYPE>CHECKING
</BANKACCTFROM>
<BANKTRANLIST>
<DTSTART><%= from.to_s("%Y%m%d") %>
<DTEND><%= to.to_s("%Y%m%d") %>
<% ps.each do |p| -%>
<STMTTRN>
<TRNTYPE>DEBIT
<DTPOSTED><%= p.date.to_s("%Y%m%d") %>
<TRNAMT><%= Domain.format_decimal(-p.amount_cents, 2, '.') %>
<FITID>zipfelkasse-<%= p.expense_id %>
<NAME><%= sgml(p.payee, 32) %>
<MEMO><%= sgml(p.memo, 255) %>
</STMTTRN>
<% end -%>
</BANKTRANLIST>
<LEDGERBAL>
<BALAMT><%= Domain.format_decimal(total, 2, '.') %>
<DTASOF><%= to.to_s("%Y%m%d") %>
</LEDGERBAL>
</STMTRS>
</STMTTRNRS>
</BANKMSGSRSV1>
</OFX>
